import json
import os

# 1. MEMBACA DATA (Ilmu Rabu: JSON Load)
data_audit_json = '''
[
    {"nama": "Server Utama", "skor": 95},
    {"nama": "Database Nasabah", "skor": 75},
    {"nama": "Printer Umum", "skor": 20}
]
'''
daftar_aset = json.loads(data_audit_json)

# 2. PROSES DATA (Ilmu Kamis: Loop & IF)
for aset in daftar_aset:
    nama = aset["nama"]
    skor = aset["skor"]
    
    if skor >= 80:
        kategori = "CRITICAL"
    elif skor >= 50:
        kategori = "MEDIUM"
    else:
        kategori = "LOW"
        
    # 3. AKSI SISTEM (Ilmu Jumat: OS Module)
    # Membuat folder otomatis berdasarkan kategori risiko
    path_folder = os.path.join("HASIL_AUDIT", kategori)
    if not os.path.exists(path_folder):
        os.makedirs(path_folder)
    
    # 4. MENULIS BUKTI (Ilmu Senin: Menulis File)
    # Membuat file teks kosong di dalam folder tersebut sebagai penanda
    nama_file_bukti = f"Bukti_{nama.replace(' ', '_')}.txt"#alasan kenapa direplace kosong agar bisa fleksibel
    #dan dimasukkan dengan bebas lalu setiap kata itu ada space berupa tanda _
    with open(os.path.join(path_folder, nama_file_bukti), 'w') as f:
        f.write(f"Laporan Audit untuk {nama}\nSkor: {skor}\nStatus: {kategori}")

print("Selesai! Semua data JSON sudah ditarik, diproses, dan dibuatkan foldernya.")
